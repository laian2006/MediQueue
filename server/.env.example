# Sao chép thành .env, điền DATABASE_URL và tạo SESSION_SECRET riêng theo README.
# Các giá trị dưới đây không phải tài khoản thật.
PORT=3000
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://mediqueue_user:replace_me@localhost:5432/mediqueue_dev

# T theo thiết kế chung v1.0.
NO_SHOW_TIMEOUT_SECONDS=60
# Tạo bằng: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Máy phát triển HTTP: false. Môi trường HTTPS trực tiếp: true.
COOKIE_SECURE=false
