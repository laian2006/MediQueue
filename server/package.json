{
  "name": "mediqueue-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/app/server.js",
    "start": "node --env-file-if-exists=.env src/app/server.js",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=4",
    "db:migrate": "node --env-file-if-exists=.env scripts/database.js migrate",
    "db:seed": "node --env-file-if-exists=.env scripts/database.js seed"
  },
  "dependencies": {
    "connect-pg-simple": "10.0.0",
    "express": "5.3.0",
    "express-session": "1.19.0",
    "pg": "8.23.1"
  }
}
